# 정글장터 — 환경변수 예시 파일.
#
# 이 파일을 .env 로 복사한 뒤 값을 채운다.  cp .env.example .env
# .env 자체는 .gitignore 에 있어서 repo 에 올라가지 않는다.
#
# 값을 만들 때:  python3 -c "import secrets; print(secrets.token_hex(32))"
# 두 시크릿은 서명 주체가 다른 별개의 신뢰 체계다. 반드시 따로 뽑는다.
# 짧거나 뜻이 있는 문자열은 쓰지 않는다. 공격자는 자기 쿠키의 토큰만 있으면
# 서버에 묻지 않고 자기 컴퓨터에서 후보 키를 무한히 대조해 볼 수 있다.

# 로그인 토큰(JWT)의 서명키. auth_util.py:23 이 읽는다.
# 팀원 셋은 반드시 같은 값을 써야 한다. 값이 다르면 한쪽에서 발급한 토큰을
# 다른 쪽이 서명 불일치로 거부한다.
# 배포 서버는 도메인이 달라 쿠키가 넘어가지 않으므로 별도 값이어도 된다.
# 다만 한 번 정한 값을 고정해야 한다. 재시작마다 바뀌면 접속자 전원이
# 로그인 화면으로 튕긴다.
JWT_SECRET=

# Flask session 쿠키의 서명키. app.py 가 app.secret_key 로 읽는다.
# 이 값이 없으면 flash() 를 부르는 순간 앱이 500 을 낸다
# (물품 등록에서 제목을 비운 채 제출하는 경우 등).
# session 은 각자의 브라우저에만 남으므로 셋이 같을 필요는 없다.
FLASK_SECRET=

# 로컬 개발에서만 1 로 둔다. .py 를 저장하면 서버가 자동으로 재시작한다.
# 배포 서버에서는 비워 둔다. 켜 두면 예외 화면에 소스가 그대로 노출된다.
FLASK_DEBUG=1
